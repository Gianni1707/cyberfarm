{
  "multipart": [
    {
      "apply": {
        "model": "cyberfarm:block/item_pipe_core"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "cyberfarm:block/item_pipe_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "cyberfarm:block/item_pipe_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "cyberfarm:block/item_pipe_side",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "cyberfarm:block/item_pipe_side",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "cyberfarm:block/item_pipe_side",
        "x": 270
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "cyberfarm:block/item_pipe_side",
        "x": 90
      }
    },
    {
      "when": {
        "north": "true",
        "extract_north": "true"
      },
      "apply": {
        "model": "cyberfarm:block/item_pipe_extract"
      }
    },
    {
      "when": {
        "east": "true",
        "extract_east": "true"
      },
      "apply": {
        "model": "cyberfarm:block/item_pipe_extract",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true",
        "extract_south": "true"
      },
      "apply": {
        "model": "cyberfarm:block/item_pipe_extract",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true",
        "extract_west": "true"
      },
      "apply": {
        "model": "cyberfarm:block/item_pipe_extract",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true",
        "extract_up": "true"
      },
      "apply": {
        "model": "cyberfarm:block/item_pipe_extract",
        "x": 270
      }
    },
    {
      "when": {
        "down": "true",
        "extract_down": "true"
      },
      "apply": {
        "model": "cyberfarm:block/item_pipe_extract",
        "x": 90
      }
    }
  ]
}
