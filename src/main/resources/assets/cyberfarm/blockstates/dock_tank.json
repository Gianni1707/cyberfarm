{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "cyberfarm:block/dock_tank"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "cyberfarm:block/dock_tank",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "cyberfarm:block/dock_tank",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "cyberfarm:block/dock_tank",
        "y": 270
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "cyberfarm:block/dock_tank_port"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "cyberfarm:block/dock_tank_port",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "cyberfarm:block/dock_tank_port",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "cyberfarm:block/dock_tank_port",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "cyberfarm:block/dock_tank_port_up"
      }
    }
  ]
}
